<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/img_result_topic_cover"
        android:layout_width="130dp"
        android:layout_height="110dp"
        android:src="@color/gray" />


    <TextView
        android:id="@+id/tv_result_topic_title"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="描述"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/img_result_topic_cover"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tv_result_topic_description"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="bottom"
        android:maxLines="2"
        android:text="11111111"
        android:textColor="@color/gray"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_result_topic_tag"
        app:layout_constraintStart_toStartOf="@+id/tv_result_topic_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_result_topic_title"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tv_result_topic_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text="114514人参与"
        android:textColor="@color/gray"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="@+id/img_result_topic_cover"
        app:layout_constraintStart_toStartOf="@+id/tv_result_topic_description" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_marginTop="15dp"
        android:src="@color/gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_result_topic_cover" />


</androidx.constraintlayout.widget.ConstraintLayout>