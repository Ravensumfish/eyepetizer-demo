<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp"
    android:layout_marginTop="5dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cd_rank_feed"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:backgroundTint="@color/gray"
        android:outlineSpotShadowColor="@color/white"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >
        <ImageView
            android:id="@+id/img_rank_feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/blue"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cd_rank_author"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/gray"
        android:outlineSpotShadowColor="@color/white"
        app:cardCornerRadius="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/cd_rank_feed"
        app:layout_constraintTop_toBottomOf="@+id/cd_rank_feed" >
        <ImageView
            android:id="@+id/img_rank_author"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/blue"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_rank_title"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="这里是标题"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/cd_rank_author"
        app:layout_constraintTop_toBottomOf="@+id/cd_rank_feed" />

    <TextView
        android:id="@+id/tv_rank_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="描述"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@+id/tv_rank_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_rank_title" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="  /  #"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_rank_name"
        app:layout_constraintStart_toEndOf="@+id/tv_rank_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_rank_title" />

    <TextView
        android:id="@+id/tv_rank_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="分类"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@+id/tv_rank_title" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="0.05dp"
        android:layout_marginTop="10dp"
        android:src="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/tv_rank_category"
        tools:layout_editor_absoluteX="3dp" />

    <TextView
        android:id="@+id/tv_rank_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_capsule"
        android:elevation="8dp"
        android:text="00:00"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/cd_rank_feed"
        app:layout_constraintEnd_toEndOf="@+id/cd_rank_feed"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>